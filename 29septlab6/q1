#include <iostream>
using namespace std;

class Distance {
    int feet, inches;

public:
    Distance(int f = 0, int i = 0) {
        feet = f;
        inches = i;
    }

    Distance operator+(Distance d) {
        Distance result;

        result.feet = feet + d.feet;
        result.inches = inches + d.inches;

        // Convert inches into feet
        if (result.inches >= 12) {
            result.feet += result.inches / 12;
            result.inches = result.inches % 12;
        }

        return result;
    }

    void display() {
        cout << feet << " feet " << inches << " inches";
    }
};

int main() {
    Distance d1(5, 8);
    Distance d2(3, 7);

    Distance d3 = d1 + d2;

    cout << "Result: ";
    d3.display();

    return 0;
}