#include <iostream>
using namespace std;

void display(int x)
{
    cout << "Integer: " << x << endl;
}

void display(float x)
{
    cout << "Float: " << x << endl;
}

void display(char x)
{
    cout << "Character: " << x << endl;
}

void display(int arr[], int n)
{
    cout << "Integer array: ";

    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";

    cout << endl;
}

void display(char arr[], int n)
{
    cout << "Character array: ";

    for(int i = 0; i < n; i++)
        cout << arr[i] << " ";

    cout << endl;
}

int main()
{
    int a[] = {1, 2, 3};
    char b[] = {'A', 'B', 'C'};

    display(10);
    display(5.5f);
    display('A');

    display(a, 3);
    display(b, 3);

    return 0;
}