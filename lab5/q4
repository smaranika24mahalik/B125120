#include <iostream>
using namespace std;

int search(int arr[], int n, int key)
{
    for(int i = 0; i < n; i++)
    {
        if(arr[i] == key)
            return i;
    }

    return -1;
}

int search(char arr[], int n, char key)
{
    for(int i = 0; i < n; i++)
    {
        if(arr[i] == key)
            return i;
    }

    return -1;
}

int search(int arr[], int start, int end, int key)
{
    for(int i = start; i <= end; i++)
    {
        if(arr[i] == key)
            return i;
    }

    return -1;
}

int main()
{
    int a[] = {10, 20, 30, 40};
    char b[] = {'a', 'b', 'c', 'd'};

    cout << "Integer position = "
         << search(a, 4, 30) << endl;

    cout << "Character position = "
         << search(b, 4, 'c') << endl;

    cout << "Range search position = "
         << search(a, 1, 3, 40) << endl;

    return 0;
}