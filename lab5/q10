#include <iostream>
using namespace std;

int process(int a, int b)
{
    return a + b;
}

float process(int a, float b)
{
    return a + b;
}

float process(float a, float b)
{
    return a + b;
}

int process(int arr[], int n)
{
    int sum = 0;

    for(int i = 0; i < n; i++)
        sum += arr[i];

    return sum;
}

int process(int *a, int *b)
{
    return *a + *b;
}

int main()
{
    int a = 10;
    int b = 20;

    float x = 5.5;
    float y = 2.5;

    int arr[] = {1, 2, 3, 4};

    cout << "Two integers = "
         << process(a, b) << endl;

    cout << "Integer + float = "
         << process(a, x) << endl;

    cout << "Two floats = "
         << process(x, y) << endl;

    cout << "Array sum = "
         << process(arr, 4) << endl;

    cout << "Two pointers = "
         << process(&a, &b) << endl;

    return 0;
}