#include <iostream>
using namespace std;

int maximum(int a, int b)
{
    return (a > b) ? a : b;
}

int maximum(int *a, int *b)
{
    return (*a > *b) ? *a : *b;
}

int maximum(int *arr, int n)
{
    int max = arr[0];

    for(int i = 1; i < n; i++)
    {
        if(arr[i] > max)
            max = arr[i];
    }

    return max;
}

int main()
{
    int a = 10;
    int b = 20;

    int arr[] = {10, 50, 30, 70, 20};

    cout << "Maximum of two integers = "
         << maximum(a, b) << endl;

    cout << "Maximum using pointers = "
         << maximum(&a, &b) << endl;

    cout << "Maximum in array = "
         << maximum(arr, 5) << endl;

    return 0;
}