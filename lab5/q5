#include <iostream>
using namespace std;

void modify(int &x, int value)
{
    x = x + value;
}

void modify(float &x, float value)
{
    x = x + value;
}

void modify(int *x, int value)
{
    *x = *x + value;
}

int main()
{
    int a = 10;
    float b = 10.5;

    cout << "Before: " << a << endl;
    modify(a, 5);
    cout << "After: " << a << endl;

    cout << "\nBefore: " << b << endl;
    modify(b, 2.5);
    cout << "After: " << b << endl;

    int c = 20;

    cout << "\nBefore: " << c << endl;
    modify(&c, 10);
    cout << "After: " << c << endl;

    return 0;
}